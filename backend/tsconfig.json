{
  "compilerOptions": {
    /* Basic Settings */
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"],
    "jsx": "react-jsx",

    /* Enable Extensionless Import Support */
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* Outputs */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Strict Type-Checking */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Fixes for Vercel Serverless Resolution */
    "verbatimModuleSyntax": false,
    "isolatedModules": false,              
    "moduleDetection": "auto",        
    "noUncheckedSideEffectImports": false 
  },
  "include": ["src/**/*"]
}